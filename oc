# Configuration & Profile Subcommand Dispatcher
def dispatch_config_command(args)
  ensure_initialized

  if args.empty? || args.first == 'list' || args.first == '-l' || args.first == '--list' || args.first == 'ls'
    list_profiles
    return
  end

  if help_arg?(args.first)
    print_usage
    return
  end

  cmd = args.shift

  case cmd
  when 'test_models', 'test-models', 'bench_models', 'bench-models', 'models_speed', 'speed_models'
    num = args.shift
    test_models_in_profile(num, args.join(' ').empty? ? nil : args.join(' '))

  when 'benchmark', 'bench', 'speed'
    benchmark_profiles(args)

  when 'test', 'check', 'verify', 'diag'
    target = args.shift
    if target =~ /^(all|--all|-a)$/i
      test_all_profiles
    else
      test_profile(target, args.join(' ').empty? ? nil : args.join(' '))
    end

  when 'info', 'show', 'inspect', 'view'
    target_num = args.shift
    if target_num =~ /^(all|--all|-a)$/i
      available_profile_nums.each do |p|
        show_profile_info(p)
      end
    else
      show_profile_info(target_num)
    end

  when 'create', 'add', 'new'
    json_file = args.shift
    if json_file.nil?
      warn red("Error: Missing JSON file path. Usage: oc conf create <path/to/config.json>")
      exit 1
    end
    create_profile(json_file)

  when 'set_default', 'set-default', 'default', 'use', 'switch', 'set'
    num = args.shift
    if num.nil?
      warn red("Usage: oc conf set_default <profile_number>")
      exit 1
    end
    set_default_profile(num)

  when 'set_model', 'set-model', 'model'
    first = args.shift
    second = args.shift
    if second
      set_profile_model(first, second)
    elsif first
      set_profile_model(nil, first)
    else
      warn red("Usage: oc conf set_model [profile_number] <model_name>")
      exit 1
    end

  when 'set_desc', 'set-desc', 'set_description', 'description', 'desc'
    first = args.shift
    second = args.join(' ').strip
    if format_num(first) && !second.empty?
      set_profile_description(first, second)
    elsif first
      set_profile_description(nil, ([first] + args).join(' ').strip)
    else
      warn red("Usage: oc conf set_desc [profile_number] <description_text>")
      exit 1
    end

  when 'set_api', 'set-api', 'setkey'
    num = args.shift
    key = args.shift
    if num.nil? || key.nil?
      warn red("Usage: oc conf set_api <profile_number> <api_key_string>")
      exit 1
    end
    set_api_key(num, key)

  else
    # Check if pattern is: oc conf <number> set_desc <desc>
    if format_num(cmd) && args.first =~ /^(set_?desc|description|desc)$/i
      args.shift
      desc = args.join(' ').strip
      if desc.empty?
        warn red("Usage: oc conf #{cmd} set_desc <description_text>")
        exit 1
      end
      set_profile_description(cmd, desc)
    # Check if pattern is: oc conf <number> test_models
    elsif format_num(cmd) && args.first =~ /^(test_?models|bench_?models|models_?speed)$/i
      args.shift
      test_models_in_profile(cmd, args.join(' ').empty? ? nil : args.join(' '))
    # Check if pattern is: oc conf <number> bench
    elsif format_num(cmd) && args.first =~ /^(benchmark|bench|speed)$/i
      args.shift
      benchmark_profiles([cmd] + args)
    # Check if pattern is: oc conf <number> test / check
    elsif format_num(cmd) && args.first =~ /^(test|check|verify|diag)$/i
      args.shift
      test_profile(cmd, args.join(' ').empty? ? nil : args.join(' '))
    # Check if pattern is: oc conf <number> info / show
    elsif format_num(cmd) && args.first =~ /^(info|show|inspect)$/i
      show_profile_info(cmd)
    # Check if pattern is: oc conf <number> set_model <model>
    elsif format_num(cmd) && args.first =~ /^(set_?model|model)$/i
      args.shift
      model = args.shift
      if model.nil?
        warn red("Usage: oc conf #{cmd} set_model <model_name>")
        exit 1
      end
      set_profile_model(cmd, model)
    # Check if pattern is: oc conf <number> set_api <key>
    elsif format_num(cmd) && args.first =~ /^set_?api$/i
      args.shift
      key = args.shift
      if key.nil?
        warn red("Usage: oc conf #{cmd} set_api <api_key_string>")
        exit 1
      end
      set_api_key(cmd, key)
    elsif format_num(cmd)
      set_default_profile(cmd)
    else
      warn red("Error: Unknown configuration command or profile '#{cmd}'")
      warn "Run 'oc help' or 'oc conf --help' for usage."
      exit 1
    end
  end
end

# OpenCode subcommands that do not take -m
STANDALONE_COMMANDS = %w[
  completion acp mcp attach debug providers auth agent
  upgrade uninstall serve web models stats export import
  github pr session plugin plug db
].freeze

# ----------------------------------------------------
# Main Execution Dispatcher
# ----------------------------------------------------
ensure_initialized

args = ARGV.dup
program_basename = File.basename($PROGRAM_NAME)

# If invoked as opencode-switch, direct straight to config dispatcher
if program_basename =~ /^opencode-switch/i
  dispatch_config_command(args)
  exit 0
end

# Check for top-level help triggers: oc help, oc -h, oc -H, oc -?, oc /?, oc /H, oc --help, etc.
if help_arg?(args.first)
  print_usage
  exit 0
end

# Check for profile management namespace: oc conf, oc config, oc cfg, oc switch
if args.first =~ /^(conf|config|cfg|switch)$/i
  args.shift
  dispatch_config_command(args)
  exit 0
end

# Check for explicit passthrough delimiter: oc -- <args...>
if args.first == '--'
  args.shift
  target_profile_num = get_default_profile
else
  # Check if first argument is a profile number (e.g. oc 02 or oc 2)
  target_profile_num = nil
  if args.any?
    candidate = format_num(args.first)
    if candidate && Dir.exist?(File.join(SWITCH_DIR, candidate))
      target_profile_num = candidate
      args.shift
    end
  end
  target_profile_num ||= get_default_profile

  # Strip optional '--' after profile number (e.g. oc 02 -- -m custom)
  args.shift if args.first == '--'
end

if target_profile_num.nil?
  warn red("Error: No OpenCode profiles configured in #{SWITCH_DIR}")
  warn "Run 'oc conf create <config.json>' to add a profile."
  exit 1
end

profile_dir = File.join(SWITCH_DIR, target_profile_num)
unless Dir.exist?(profile_dir)
  warn red("Error: Profile '#{target_profile_num}' directory not found at #{profile_dir}")
  exit 1
end

# 1. Source API_key.sh and inject variables into ENV
api_script = File.join(profile_dir, 'API_key.sh')
if File.exist?(api_script)
  cmd = "set -a; source '#{api_script}' >/dev/null 2>&1; env -0"
  env_out, status = Open3.capture2('bash', '-c', cmd)
  if status.success?
    env_out.split("\0").each do |pair|
      k, v = pair.split('=', 2)
      ENV[k] = v if k && !k.empty?
    end
  else
    warn yellow("Warning: Failed to execute #{api_script}")
  end
end

# 2. Copy config.json over to active ~/.config/opencode/opencode.json and clean shadowing files
FileUtils.rm_f(TARGET_JSONC)

cfg_src = File.join(profile_dir, 'config.json')
profile_model = nil

if File.exist?(cfg_src)
  FileUtils.rm_f(TARGET_CFG)
  FileUtils.cp(cfg_src, TARGET_CFG)
  begin
    data = JSON.parse(File.read(cfg_src))
    profile_model = data['model']
  rescue StandardError
  end
else
  warn yellow("Warning: Missing #{cfg_src}")
end

# 3. Handle model forwarding if not explicitly supplied
has_model_flag = args.any? { |a| a == '-m' || a == '--model' || a.start_with?('-m=') || a.start_with?('--model=') }
is_subcommand = args.first && STANDALONE_COMMANDS.include?(args.first.downcase)

if profile_model && !has_model_flag && !is_subcommand
  args.unshift('-m', profile_model)
end

# 4. Locate and execute opencode binary
opencode_bin = ENV['OPENCODE_BIN'] ||
               `which opencode 2>/dev/null`.strip

opencode_bin = File.expand_path('~/.opencode/bin/opencode') if opencode_bin.empty? || !File.exist?(opencode_bin)

unless File.exist?(opencode_bin)
  warn red("Error: Could not locate 'opencode' binary.")
  exit 1
end

$stderr.puts cyan("[oc] Active Profile: #{bold(target_profile_num)} | Model: #{bold(profile_model || '(default)')}")
exec(opencode_bin, *args)
