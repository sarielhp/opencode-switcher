#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
require 'json'
require 'open3'
require 'net/http'
require 'uri'
require 'shellwords'

VERSION      = '0.1.3'
SWITCH_DIR   = File.expand_path('~/.config/opencode-switcher')
LEGACY_DIRS  = [
  File.expand_path('~/.config/opencode_switch'),
  File.expand_path('~/.config/opencode-switch')
].freeze

# Automatically migrate legacy config directory if present
if !Dir.exist?(SWITCH_DIR)
  legacy_found = LEGACY_DIRS.find { |d| Dir.exist?(d) }
  if legacy_found
    FileUtils.mv(legacy_found, SWITCH_DIR)
    begin
      FileUtils.ln_s(SWITCH_DIR, legacy_found) unless File.exist?(legacy_found)
    rescue StandardError
      # Ignore symlink error if not permitted
    end
  end
end

DEFAULT_FILE = File.join(SWITCH_DIR, 'default.json')
OPENCODE_DIR = File.expand_path('~/.config/opencode')
TARGET_CFG   = File.join(OPENCODE_DIR, 'opencode.json')
TARGET_JSONC = File.join(OPENCODE_DIR, 'opencode.jsonc')

FileUtils.mkdir_p(SWITCH_DIR)
FileUtils.mkdir_p(OPENCODE_DIR)

# ANSI terminal formatting
def colorize(text, code)
  $stdout.tty? ? "\e[#{code}m#{text}\e[0m" : text
end

def green(t);  colorize(t, 32); end
def cyan(t);   colorize(t, 36); end
def yellow(t); colorize(t, 33); end
def red(t);    colorize(t, 31); end
def bold(t);   colorize(t, 1);  end

# Check if an argument is a help flag (e.g. help, -?, /?, /h, /H, -h, -H, --help, etc.)
def help_arg?(arg)
  return false if arg.nil?
  arg.to_s.strip =~ /^([-\/+]{1,2}(h|help|\?)|help|\?)$/i
end

# Check if an argument is a version flag (e.g. version, -v, -V, --version)
def version_arg?(arg)
  return false if arg.nil?
  arg.to_s.strip =~ /^([-\/+]{1,2}(v|version)|version)$/i
end

# Format profile number into 2-digit format ("1" -> "01", "02" -> "02")
def format_num(num_str)
  num = num_str.to_s.strip.to_i
  return nil if num <= 0
  format('%02d', num)
end

# List all profile numbers (e.g. ["01", "02", ...])
def available_profile_nums
  Dir.glob(File.join(SWITCH_DIR, '[0-9]*'))
     .select { |p| File.directory?(p) }
     .map { |p| File.basename(p) }
     .sort_by { |n| [n.to_i, n] }
end

# Get current default profile number from default.json
def get_default_profile
  if File.exist?(DEFAULT_FILE)
    begin
      data = JSON.parse(File.read(DEFAULT_FILE))
      num = format_num(data['default']) unless data['default'].nil?
      return num if num
    rescue StandardError
      # Ignore read errors
    end
  end
  available_profile_nums.first
end

# Parse JSON with Comments (JSONC), supporting single-line (//), block (/* */),
# and trailing commas before } or ]. Preserves strings containing // or /*.
def parse_jsonc(content)
  return {} if content.nil? || content.strip.empty?
  # Remove block and line comments while preserving double-quoted strings
  cleaned = content.gsub(/("(?:[^"\\]|\\.)*")|(\/\*[\s\S]*?\*\/|\/\/[^\n]*)/) do
    $1 ? $1 : ''
  end
  # Remove trailing commas before closing braces/brackets. Strings are matched
  # first so a value like "a, }" is never altered.
  cleaned = cleaned.gsub(/("(?:[^"\\]|\\.)*")|,(\s*(?=[\]}]))/) { $1 ? $1 : $2 }
  JSON.parse(cleaned)
end

# Recursively deep merge two hashes.
# Arrays are concatenated and deduplicated ((base + override).uniq).
# Hashes are merged recursively.
# Primitives in override overwrite base.
def deep_merge(base, override)
  return (override || {}).dup if base.nil?
  return (base || {}).dup if override.nil?

  base.merge(override) do |_key, old_val, new_val|
    if old_val.is_a?(Hash) && new_val.is_a?(Hash)
      deep_merge(old_val, new_val)
    elsif old_val.is_a?(Array) && new_val.is_a?(Array)
      (old_val + new_val).uniq
    else
      new_val
    end
  end
end

# Find base configuration file (base.jsonc or base.json) in SWITCH_DIR
def find_base_config_file
  [
    File.join(SWITCH_DIR, 'base.jsonc'),
    File.join(SWITCH_DIR, 'base.json')
  ].find { |f| File.exist?(f) }
end

# Find config file for a profile (config.jsonc or config.json)
def find_profile_config_file(profile_dir)
  return nil unless profile_dir && Dir.exist?(profile_dir)
  [
    File.join(profile_dir, 'config.jsonc'),
    File.join(profile_dir, 'config.json')
  ].find { |f| File.exist?(f) }
end

# Load raw profile delta config (as Hash)
def load_profile_raw_config(profile_dir)
  cfg_file = find_profile_config_file(profile_dir)
  return {} unless cfg_file && File.exist?(cfg_file)
  parse_jsonc(File.read(cfg_file)) rescue {}
end

# Load base config (as Hash)
def load_base_config
  base_file = find_base_config_file
  return {} unless base_file && File.exist?(base_file)
  parse_jsonc(File.read(base_file)) rescue {}
end

# Compile effective configuration by deep-merging base.jsonc and profile delta
def compile_profile_config(num_str)
  num = format_num(num_str)
  return {} unless num
  profile_dir = File.join(SWITCH_DIR, num)
  return {} unless Dir.exist?(profile_dir)

  base_cfg = load_base_config
  prof_cfg = load_profile_raw_config(profile_dir)
  deep_merge(base_cfg, prof_cfg)
end

# Locate opencode binary
def locate_opencode_bin
  bin = ENV['OPENCODE_BIN'] || `which opencode 2>/dev/null`.strip
  bin = File.expand_path('~/.opencode/bin/opencode') if bin.empty? || !File.exist?(bin)
  File.exist?(bin) ? bin : nil
end

# Load environment variables from a profile's API_key.sh into ENV
def load_profile_env(num_str)
  num = format_num(num_str)
  return unless num

  api_script = File.join(SWITCH_DIR, num.to_s, 'API_key.sh')
  return unless File.exist?(api_script)

  cmd = "set -a; source '#{api_script}' >/dev/null 2>&1; env -0"
  env_out, status = Open3.capture2('bash', '-c', cmd)
  return unless status.success?

  env_out.split("\0").each do |pair|
    k, v = pair.split('=', 2)
    ENV[k] = v if k && !k.empty?
  end
end

# Read the variables exported by a profile's API_key.sh without guessing at
# quoting: source it in a subshell and diff the environment against a clean
# base. Returns an ordered array of [name, value] pairs (values are the actual
# shell-interpreted strings, so escapes/quotes are handled correctly).
def read_profile_api_vars(api_script)
  return [] unless api_script && File.exist?(api_script)

  base_out, = Open3.capture2('bash', '-c', 'env -0')
  sourced_cmd = "set -a; source '#{api_script}' >/dev/null 2>&1; env -0"
  env_out, status = Open3.capture2('bash', '-c', sourced_cmd)
  return [] unless status.success?

  base = {}
  base_out.split("\0").each do |pair|
    k, v = pair.split('=', 2)
    base[k] = v if k && !k.empty?
  end

  vars = []
  env_out.split("\0").each do |pair|
    k, v = pair.split('=', 2)
    next unless k && !k.empty?
    vars << [k, v] if !base.key?(k) || base[k] != v
  end
  vars
end

# Reload or restart running OpenCode service (if running in OpenCode 2.0)
def reload_opencode_service(restart: false)
  bin = locate_opencode_bin
  return unless bin

  status_out, status = Open3.capture2(bin, 'service', 'status') rescue nil
  return unless status&.success? && status_out.to_s.strip =~ %r{^https?://}

  action = restart ? 'restart' : 'reload'
  Open3.capture2(bin, 'service', action) rescue nil
end

# Extract and remove -m/--model flag from CLI arguments
def extract_model_override!(args)
  model = nil
  indices = []

  args.each_with_index do |arg, idx|
    if (arg == '-m' || arg == '--model') && idx + 1 < args.size
      model = args[idx + 1]
      indices = [idx, idx + 1]
      break
    end
    if arg.start_with?('-m=', '--model=')
      model = arg.split('=', 2).last
      indices = [idx]
      break
    end
  end

  indices.reverse_each { |i| args.delete_at(i) }
  model
end

# Check if 'run' subcommand was given a message argument
def run_has_message?(args)
  return false if args.size <= 1

  flags_with_val = %w[
    -m --model -f --file --format -s --session
    --agent --title --server --log-level --completions --prompt
  ]

  i = 1
  while i < args.size
    arg = args[i]
    if arg == '--'
      return i + 1 < args.size
    end
    if flags_with_val.include?(arg)
      i += 2
    elsif arg.start_with?('-')
      i += 1
    else
      return true
    end
  end

  false
end


# Atomically write content to a file (write temp file in the same dir, then
# rename). Preserves an existing target's permissions, fsyncs the temp file
# before renaming, and cleans up a leftover temp file if anything fails.
def atomic_write(path, content)
  tmp = "#{path}.tmp.#{Process.pid}"
  begin
    File.open(tmp, 'w') do |f|
      f.write(content)
      f.flush
      f.fsync
    end
    # Preserve the target's existing mode (File.rename would otherwise use the
    # temp file's default permissions).
    File.chmod(File.stat(path).mode & 0o7777, tmp) if File.exist?(path)
    File.rename(tmp, path)
  ensure
    FileUtils.rm_f(tmp) if File.exist?(tmp)
  end
end

# Remove stale atomic_write temp files left behind by a crashed/killed run.
def sweep_stale_tmp_files
  Dir.glob(File.join(SWITCH_DIR, '*.tmp.*')).each do |f|
    pid = f[/\.tmp\.(\d+)\z/, 1]
    next unless pid
    begin
      Process.kill(0, pid.to_i)
    rescue Errno::ESRCH
      FileUtils.rm_f(f) # process no longer exists
    rescue Errno::EPERM
      # process exists but is owned by another user; leave it alone
    end
  end
  Dir.glob(File.join(OPENCODE_DIR, '*.tmp.*')).each do |f|
    pid = f[/\.tmp\.(\d+)\z/, 1]
    next unless pid
    begin
      Process.kill(0, pid.to_i)
    rescue Errno::ESRCH
      FileUtils.rm_f(f)
    rescue Errno::EPERM
      # ignore
    end
  end
end

# Compile and activate profile in ~/.config/opencode/opencode.json
def compile_and_switch_profile(num_str, reload: true)
  num = format_num(num_str)
  profile_dir = File.join(SWITCH_DIR, num.to_s)
  unless num && Dir.exist?(profile_dir)
    warn red("Error: Profile '#{num_str}' does not exist.")
    warn "Available profiles: #{available_profile_nums.join(', ')}"
    exit 1
  end

  load_profile_env(num)
  final_cfg = compile_profile_config(num)
  if final_cfg.empty?
    warn red("Error: Profile '#{num}' configuration is empty or could not be parsed.")
    exit 1
  end

  # Remove shadowing files and atomically write compiled opencode.json
  FileUtils.rm_f(TARGET_JSONC)
  atomic_write(TARGET_CFG, JSON.pretty_generate(final_cfg))

  atomic_write(DEFAULT_FILE, JSON.pretty_generate({ 'default' => num }))
  reload_opencode_service(restart: true) if reload
  final_cfg
end


# Set default profile number in default.json and compile active config
def set_default_profile(num_str)
  num = format_num(num_str)
  final_cfg = compile_and_switch_profile(num_str)
  puts green("✓ Default profile set to #{bold(num)}")
  final_cfg
end

# Inspect JSON config structure to find API environment variable names
def detect_api_env_vars(json_data)
  vars = []

  search_obj = lambda do |obj, provider_name|
    if obj.is_a?(Hash)
      obj.each do |k, v|
        if k == 'provider' && v.is_a?(Hash)
          v.each do |p_name, p_val|
            search_obj.call(p_val, p_name)
          end
        elsif k.to_s =~ /\AapiKey\z/i
          if v.is_a?(String)
            if v =~ /\{env:([^}]+)\}/
              vars << $1.strip
            elsif v =~ /^\$([A-Za-z0-9_]+)$/
              vars << $1.strip
            elsif provider_name
              var_name = "#{provider_name.upcase.gsub(/[^A-Z0-9]/, '_')}_API_KEY"
              vars << var_name
            else
              vars << 'API_KEY'
            end
          end
        else
          search_obj.call(v, provider_name)
        end
      end
    elsif obj.is_a?(Array)
      obj.each { |item| search_obj.call(item, provider_name) }
    end
  end

  search_obj.call(json_data, nil)

  if vars.empty? && json_data.is_a?(Hash) && json_data['provider'].is_a?(Hash)
    json_data['provider'].keys.each do |p_name|
      vars << "#{p_name.upcase.gsub(/[^A-Z0-9]/, '_')}_API_KEY"
    end
  end

  vars.uniq
end

# Ensure JSON config uses {env:VAR_NAME} placeholders for apiKey fields.
# When `only` is provided, it restricts rewriting to the listed provider names
# (providers outside the list are left exactly as-is).
def inject_env_placeholders!(json_data, env_var_map, only: nil)
  update_obj = lambda do |obj, provider_name|
    if obj.is_a?(Hash)
      obj.each do |k, v|
        if k == 'provider' && v.is_a?(Hash)
          v.each do |p_name, p_val|
            update_obj.call(p_val, p_name)
          end
        elsif k.to_s =~ /\AapiKey\z/i && v.is_a?(String)
          if v !~ /\{env:[^}]+\}/ && (only.nil? || only.include?(provider_name))
            var = env_var_map[provider_name] ||
                  "#{provider_name.to_s.upcase.gsub(/[^A-Z0-9]/, '_')}_API_KEY"
            obj[k] = "{env:#{var}}"
          end
        else
          update_obj.call(v, provider_name)
        end
      end
    elsif obj.is_a?(Array)
      obj.each { |item| update_obj.call(item, provider_name) }
    end
  end

  update_obj.call(json_data, nil)
end

# Conventional API key env var name for a provider id
def conventional_api_var(provider_name)
  "#{provider_name.to_s.upcase.gsub(/[^A-Z0-9]/, '_')}_API_KEY"
end

# Build a provider-keyed env var map for set_api_key so that a key update only
# rewrites the apiKey of the provider it belongs to. Providers whose var name
# cannot be matched to the requested var are left untouched (their literal keys
# are preserved), avoiding collapsing every provider onto a single variable.
def build_api_var_map(json_data, var_name)
  providers = json_data.is_a?(Hash) && json_data['provider'].is_a?(Hash) ? json_data['provider'] : {}
  candidates = providers.select do |p_name, p_val|
    next false unless p_val.is_a?(Hash) && p_val['options'].is_a?(Hash)
    p_val['options']['apiKey'].is_a?(String)
  end

  map = {}
  candidates.each_key do |p_name|
    map[p_name] = var_name if conventional_api_var(p_name) == var_name
  end

  # Fall back to the sole provider holding an apiKey when the var name is custom
  if map.empty? && candidates.size == 1
    map[candidates.keys.first] = var_name
  end

  map
end

# Check and perform first-time setup
def ensure_initialized
  profiles = available_profile_nums
  return unless profiles.empty?

  puts yellow("Initializing OpenCode Switcher for the first time...")
  profile_1_dir = File.join(SWITCH_DIR, '01')
  FileUtils.mkdir_p(profile_1_dir)

  initial_cfg = TARGET_CFG
  if !File.exist?(initial_cfg)
    fallback = File.join(OPENCODE_DIR, 'old', 'opencode.json')
    initial_cfg = fallback if File.exist?(fallback)
  end

  if File.exist?(initial_cfg)
    content = File.read(initial_cfg)
    json_data = JSON.parse(content) rescue {}

    # Detect env vars and check if literal API keys are present
    env_vars = detect_api_env_vars(json_data)
    env_var_map = {}
    literal_key = nil

    if json_data['provider'].is_a?(Hash)
      json_data['provider'].each do |p_name, p_val|
        if p_val.is_a?(Hash) && p_val['options'].is_a?(Hash) && p_val['options']['apiKey']
          key_val = p_val['options']['apiKey'].to_s
          if key_val !~ /\{env:[^}]+\}/ && !key_val.empty?
            literal_key = key_val
          end
        end
        env_var_map[p_name] = "#{p_name.upcase.gsub(/[^A-Z0-9]/, '_')}_API_KEY"
      end
    end

    inject_env_placeholders!(json_data, env_var_map) if literal_key
    File.write(File.join(profile_1_dir, 'config.json'), JSON.pretty_generate(json_data))

    primary_var = env_vars.first || 'OPENROUTER_API_KEY'
    key_to_set = literal_key || ENV[primary_var] || ''

    script_content = <<~SH
      #!/usr/bin/env bash
      # API Key configuration for Profile 01
      export #{primary_var}=#{Shellwords.escape(key_to_set.to_s)}
    SH

    api_script = File.join(profile_1_dir, 'API_key.sh')
    File.write(api_script, script_content)
    FileUtils.chmod(0755, api_script)
    File.write(DEFAULT_FILE, JSON.pretty_generate({ 'default' => '01' }))
    puts green("✓ Created Profile 01 from existing OpenCode config (#{initial_cfg})")
  else
    default_config = {
      "$schema" => "https://opencode.ai/config.json",
      "model" => "openrouter/deepseek/deepseek-v4-flash",
      "provider" => {
        "openrouter" => {
          "npm" => "@ai-sdk/openai-compatible",
          "name" => "OpenRouter",
          "options" => {
            "baseURL" => "https://openrouter.ai/api/v1",
            "apiKey" => "{env:OPENROUTER_API_KEY}"
          }
        }
      }
    }
    File.write(File.join(profile_1_dir, 'config.json'), JSON.pretty_generate(default_config))
    api_script = File.join(profile_1_dir, 'API_key.sh')
    File.write(api_script, "#!/usr/bin/env bash\nexport OPENROUTER_API_KEY=\"\"\n")
    FileUtils.chmod(0755, api_script)
    File.write(DEFAULT_FILE, JSON.pretty_generate({ 'default' => '01' }))
    puts green("✓ Created initial Profile 01")
  end
end

# List all available profiles
def list_profiles
  ensure_initialized
  profiles = available_profile_nums
  default_num = get_default_profile
  base_file = find_base_config_file

  base_note = base_file ? cyan(" (base: #{File.basename(base_file)})") : ""
  puts bold("OpenCode Profiles (~/.config/opencode-switcher/):#{base_note}")
  profiles.each_with_index do |p_num, idx|
    is_default = (p_num == default_num)
    indicator = is_default ? green("  * #{p_num} [default]") : "    #{p_num}          "

    p_dir = File.join(SWITCH_DIR, p_num)
    cfg_file = find_profile_config_file(p_dir)
    api_file = File.join(p_dir, 'API_key.sh')

    model = '(no default model)'
    provider = '(none)'
    description = nil
    base_url = nil

    if cfg_file && File.exist?(cfg_file)
      begin
        raw_data = load_profile_raw_config(p_dir)
        compiled_data = compile_profile_config(p_num)
        description = raw_data['description'] || compiled_data['description']
        model = raw_data['model'] || compiled_data['model'] || '(no default model)'

        providers = raw_data['provider'] || compiled_data['provider']
        if providers.is_a?(Hash) && !providers.empty?
          provider = providers.keys.join(', ')
          first_p = providers.values.first
          if first_p.is_a?(Hash) && first_p['options'].is_a?(Hash)
            base_url = first_p['options']['baseURL']
          end
        end
      rescue StandardError
        model = '(invalid json/jsonc)'
      end
    end

    # Check API key status in API_key.sh
    key_info = ''
    if File.exist?(api_file)
      var_matches = read_profile_api_vars(api_file)
      if var_matches.any?
        var_summaries = var_matches.map do |var, val|
          val_display = val.strip.empty? ? red('EMPTY') : green('SET')
          "#{var}: #{val_display}"
        end
        key_info = "[#{var_summaries.join(', ')}]"
      else
        key_info = "[#{yellow('No export in API_key.sh')}]"
      end
    else
      key_info = "[#{red('Missing API_key.sh')}]"
    end

    desc_label = description ? " #{bold(cyan("\"#{description}\""))} —" : ""
    line1 = "#{indicator}#{desc_label} #{yellow("Provider: #{provider}")} #{key_info}"
    url_part = base_url ? " | URL: #{base_url}" : ""
    line2 = "       #{cyan("Model: #{model}")}#{url_part}"

    puts "" if idx > 0
    puts line1
    puts line2
  end
end

# Set description for a profile
def set_profile_description(num_str, desc_text)
  ensure_initialized
  num = format_num(num_str) || get_default_profile
  profile_dir = File.join(SWITCH_DIR, num.to_s)

  unless num && Dir.exist?(profile_dir)
    warn red("Error: Profile '#{num_str}' does not exist.")
    exit 1
  end

  cfg_file = find_profile_config_file(profile_dir)
  unless cfg_file && File.exist?(cfg_file)
    warn red("Error: config file not found in #{profile_dir}")
    exit 1
  end

  data = parse_jsonc(File.read(cfg_file)) rescue nil
  unless data
    warn red("Error: Invalid JSON/JSONC in #{cfg_file}")
    exit 1
  end

  data['description'] = desc_text
  File.write(cfg_file, JSON.pretty_generate(data))

  if num == get_default_profile
    compile_and_switch_profile(num)
  end

  puts green("✓ Updated description for Profile #{bold(num)} to: #{bold(cyan(desc_text))}")
end

# Create a new profile from a JSON or JSONC file
def create_profile(json_path)
  ensure_initialized
  unless File.exist?(json_path)
    warn red("Error: Config file '#{json_path}' does not exist.")
    exit 1
  end

  raw_content = File.read(json_path)
  json_data = parse_jsonc(raw_content) rescue nil
  unless json_data
    warn red("Error: File '#{json_path}' is not valid JSON or JSONC.")
    exit 1
  end

  existing_nums = available_profile_nums.map(&:to_i)
  next_int = (existing_nums.max || 0) + 1
  next_num = format('%02d', next_int)

  profile_dir = File.join(SWITCH_DIR, next_num)
  FileUtils.mkdir_p(profile_dir)

  env_vars = detect_api_env_vars(json_data)
  env_var_map = {}
  literal_key = nil

  if json_data['provider'].is_a?(Hash)
    json_data['provider'].each do |p_name, p_val|
      if p_val.is_a?(Hash) && p_val['options'].is_a?(Hash) && p_val['options']['apiKey']
        key_val = p_val['options']['apiKey'].to_s
        if key_val !~ /\{env:[^}]+\}/ && !key_val.empty?
          literal_key = key_val
        end
      end
      env_var_map[p_name] = "#{p_name.upcase.gsub(/[^A-Z0-9]/, '_')}_API_KEY"
    end
  end

  inject_env_placeholders!(json_data, env_var_map)

  dest_ext = json_path.end_with?('.jsonc') ? 'config.jsonc' : 'config.json'
  dest_cfg = File.join(profile_dir, dest_ext)
  File.write(dest_cfg, JSON.pretty_generate(json_data))

  primary_var = env_vars.first || 'API_KEY'
  key_to_set = literal_key || ''

  api_script_content = <<~SH
    #!/usr/bin/env bash
    # API key environment configuration for Profile #{next_num}
    export #{primary_var}=#{Shellwords.escape(key_to_set.to_s)}
  SH

  dest_api = File.join(profile_dir, 'API_key.sh')
  File.write(dest_api, api_script_content)
  FileUtils.chmod(0755, dest_api)

  puts green("✓ Created Profile #{bold(next_num)} in #{profile_dir}")
  puts "  Config:  #{dest_cfg}"
  puts "  API Key: #{dest_api} (#{primary_var}: #{key_to_set.empty? ? yellow('empty') : green('configured')})"

  if key_to_set.empty?
    puts "\nTo set the API key for this profile, run:"
    puts "  #{cyan("oc conf #{next_num} set_api \"<YOUR_API_KEY>\"")}"
  end
end

# Set API key for a profile
def set_api_key(num_str, api_key_value)
  ensure_initialized
  num = format_num(num_str)
  profile_dir = File.join(SWITCH_DIR, num.to_s)

  unless num && Dir.exist?(profile_dir)
    warn red("Error: Profile '#{num_str}' does not exist.")
    exit 1
  end

  if api_key_value.to_s.include?("\0")
    warn red("Error: API key must not contain NUL bytes.")
    exit 1
  end

  api_file = File.join(profile_dir, 'API_key.sh')
  cfg_file = find_profile_config_file(profile_dir)

  var_name = nil
  if File.exist?(api_file)
    content = File.read(api_file)
    if content =~ /export\s+([A-Za-z0-9_]+)=/
      var_name = $1
    end
  end

  if var_name.nil? && cfg_file && File.exist?(cfg_file)
    json_data = parse_jsonc(File.read(cfg_file)) rescue {}
    var_name = detect_api_env_vars(json_data).first
  end

  var_name ||= 'API_KEY'

  script_content = <<~SH
    #!/usr/bin/env bash
    # API key environment configuration for Profile #{num}
    export #{var_name}=#{Shellwords.escape(api_key_value.to_s)}
  SH

  File.write(api_file, script_content)
  FileUtils.chmod(0755, api_file)

  if cfg_file && File.exist?(cfg_file)
    json_data = parse_jsonc(File.read(cfg_file)) rescue nil
    if json_data
      var_map = build_api_var_map(json_data, var_name)
      inject_env_placeholders!(json_data, var_map, only: var_map.keys)
      File.write(cfg_file, JSON.pretty_generate(json_data))
    end
  end

  puts green("✓ Updated #{bold(var_name)} for Profile #{bold(num)}")
end

# Mask API key for display
def mask_key(key)
  return red('[NOT SET / EMPTY]') if key.nil? || key.strip.empty?
  key = key.strip
  return '••••••••' if key.length < 10
  "#{key[0..7]}...#{key[-4..-1]}"
end

