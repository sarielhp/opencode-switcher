# Benchmark profile generation speed (tokens/sec and latency)
def benchmark_profiles(profile_list = [], custom_prompt = nil, max_tokens = 400)
  ensure_initialized
  targets = profile_list.map { |p| format_num(p) }.compact
  targets = [get_default_profile] if targets.empty?
  targets = available_profile_nums if profile_list.include?('all')

  prompt = custom_prompt || 'Write a clean Ruby implementation of Dijkstra shortest path algorithm with a Priority Queue and tests.'

  puts bold("⚡ Running LLM Speed Benchmark on #{targets.size} profile(s)...")
  puts "Prompt: \"#{prompt[0..60]}...\" (max #{max_tokens} tokens)\n\n"

  results = []

  targets.each do |num|
    p_dir = File.join(SWITCH_DIR, num.to_s)
    cfg_file = File.join(p_dir, 'config.json')
    api_file = File.join(p_dir, 'API_key.sh')

    unless File.exist?(cfg_file)
      warn red("Profile #{num}: config.json not found.")
      next
    end

    data = JSON.parse(File.read(cfg_file)) rescue {}
    model = data['model']
    provider_info = data['provider']&.values&.first || {}
    provider_id = data['provider']&.keys&.first || 'provider'
    provider_name = provider_info['name'] || provider_id
    base_url = provider_info.dig('options', 'baseURL') || 'https://openrouter.ai/api/v1'

    api_key = ''
    if File.exist?(api_file)
      content = File.read(api_file)
      match = content.scan(/export\s+[A-Za-z0-9_]+=["']?([^"'\n]*)["']?/).flatten.first
      api_key = match if match
    end

    raw_model = model.to_s.strip
    raw_model = raw_model.sub(/^#{Regexp.escape(provider_id.to_s)}\//, '')

    print "  • Benchmarking Profile #{bold(cyan(num))} (#{provider_name} - #{raw_model})... "
    $stdout.flush

    endpoint_url = "#{base_url.chomp('/')}/chat/completions"
    uri = URI.parse(endpoint_url)

    req = Net::HTTP::Post.new(uri)
    req['Authorization'] = "Bearer #{api_key}"
    req['Content-Type'] = 'application/json'
    req['HTTP-Referer'] = 'https://opencode.ai'
    req['X-Title'] = 'OpenCode Benchmark'
    req.body = JSON.generate({
      model: raw_model,
      messages: [{ role: 'user', content: prompt }],
      max_tokens: max_tokens,
      stream: false
    })

    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = (uri.scheme == 'https')
    http.open_timeout = 15
    http.read_timeout = 90

    t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    res = http.request(req) rescue nil
    t1 = Process.clock_gettime(Process::CLOCK_MONOTONIC)

    total_time = (t1 - t0).round(2)

    if res && res.is_a?(Net::HTTPSuccess)
      res_json = JSON.parse(res.body) rescue {}
      tokens_out = res_json.dig('usage', 'completion_tokens') || 0
      tokens_in = res_json.dig('usage', 'prompt_tokens') || 0
      speed = tokens_out > 0 && total_time > 0 ? (tokens_out / total_time).round(1) : 0

      puts green("#{speed} tok/s") + " (#{tokens_out} tokens in #{total_time}s)"
      results << {
        num: num,
        provider: provider_name,
        model: raw_model,
        time: total_time,
        tokens_out: tokens_out,
        speed: speed,
        ok: true
      }
    else
      err_msg = res ? "HTTP #{res.code}" : 'Connection error'
      puts red("FAILED (#{err_msg})")
      results << {
        num: num,
        provider: provider_name,
        model: raw_model,
        time: total_time,
        ok: false,
        error: err_msg
      }
    end
  end

  if results.size >= 2
    successful = results.select { |r| r[:ok] }
    if successful.size >= 2
      sorted = successful.sort_by { |r| -r[:speed] }
      winner = sorted.first
      runner_up = sorted[1]
      ratio = (winner[:speed] / [runner_up[:speed], 0.01].max).round(2)

      puts "\n" + bold("=================== Benchmark Summary ===================")
      sorted.each_with_index do |r, rank|
        badge = rank == 0 ? green("🥇 #{r[:speed]} tok/s (Fastest)") : "   #{r[:speed]} tok/s"
        puts "  Profile #{cyan(r[:num])} [#{r[:provider]}]: #{badge} - #{r[:tokens_out]} tokens in #{r[:time]}s"
      end
      puts '---------------------------------------------------------'
      puts green("🏆 Profile #{winner[:num]} (#{winner[:provider]}) is #{ratio}x faster than Profile #{runner_up[:num]}!")
      puts bold("=========================================================")
    end
  end
end

# Test and benchmark all models configured in a specific profile
def test_models_in_profile(num_str = nil, custom_prompt = nil, max_tokens = 400)
  ensure_initialized
  num = format_num(num_str) || get_default_profile
  profile_dir = File.join(SWITCH_DIR, num.to_s)

  unless num && Dir.exist?(profile_dir)
    warn red("Error: Profile '#{num_str}' does not exist.")
    warn "Available profiles: #{available_profile_nums.join(', ')}"
    exit 1
  end

  cfg_file = File.join(profile_dir, 'config.json')
  api_file = File.join(profile_dir, 'API_key.sh')

  unless File.exist?(cfg_file)
    warn red("Error: config.json not found in #{profile_dir}")
    exit 1
  end

  data = JSON.parse(File.read(cfg_file)) rescue {}
  provider_info = data['provider']&.values&.first || {}
  provider_id = data['provider']&.keys&.first || 'provider'
  provider_name = provider_info['name'] || provider_id
  base_url = provider_info.dig('options', 'baseURL') || 'https://openrouter.ai/api/v1'

  api_key = ''
  if File.exist?(api_file)
    content = File.read(api_file)
    match = content.scan(/export\s+[A-Za-z0-9_]+=["']?([^"'\n]*)["']?/).flatten.first
    api_key = match if match
  end

  configured_models = provider_info['models']
  model_list = []
  if configured_models.is_a?(Hash) && !configured_models.empty?
    configured_models.each do |m_id, m_cfg|
      m_name = m_cfg.is_a?(Hash) ? (m_cfg['name'] || m_id) : m_id
      model_list << { id: m_id, name: m_name }
    end
  else
    default_m = data['model'].to_s.sub(/^#{Regexp.escape(provider_id)}\//, '')
    model_list << { id: default_m, name: default_m }
  end

  prompt = custom_prompt || 'Write a clean Ruby implementation of Dijkstra shortest path algorithm with a Priority Queue and tests.'

  puts bold("⚡ Speed Testing All #{model_list.size} Models in Profile #{cyan(num)} (#{provider_name})...")
  puts "Access Point: #{green(base_url)}"
  puts "Prompt:       \"#{prompt[0..60]}...\" (max #{max_tokens} tokens)\n\n"

  results = []
  endpoint_url = "#{base_url.chomp('/')}/chat/completions"
  uri = URI.parse(endpoint_url)

  model_list.each_with_index do |m, idx|
    m_id = m[:id]
    m_name = m[:name]
    print "  [#{idx + 1}/#{model_list.size}] Testing #{bold(cyan(m_id.ljust(26)))} ... "
    $stdout.flush

    req = Net::HTTP::Post.new(uri)
    req['Authorization'] = "Bearer #{api_key}"
    req['Content-Type'] = 'application/json'
    req['HTTP-Referer'] = 'https://opencode.ai'
    req['X-Title'] = 'OpenCode Model Benchmark'
    req.body = JSON.generate({
      model: m_id,
      messages: [{ role: 'user', content: prompt }],
      max_tokens: max_tokens,
      stream: false
    })

    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = (uri.scheme == 'https')
    http.open_timeout = 15
    http.read_timeout = 90

    t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    res = http.request(req) rescue nil
    t1 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    total_time = (t1 - t0).round(2)

    if res && res.is_a?(Net::HTTPSuccess)
      res_json = JSON.parse(res.body) rescue {}
      tokens_out = res_json.dig('usage', 'completion_tokens') || 0
      speed = tokens_out > 0 && total_time > 0 ? (tokens_out / total_time).round(1) : 0
      puts green("#{speed} tok/s") + " (#{tokens_out} tokens in #{total_time}s)"
      results << {
        id: m_id,
        name: m_name,
        time: total_time,
        tokens_out: tokens_out,
        speed: speed,
        ok: true
      }
    else
      err_msg = res ? "HTTP #{res.code}" : 'Connection error'
      puts red("FAILED (#{err_msg})")
      results << {
        id: m_id,
        name: m_name,
        time: total_time,
        ok: false,
        error: err_msg
      }
    end
  end

  successful = results.select { |r| r[:ok] }
  if successful.any?
    sorted = successful.sort_by { |r| -r[:speed] }
    puts "\n" + bold("=================== Profile #{num} Model Speed Leaderboard ===================")
    sorted.each_with_index do |r, rank|
      medal = case rank
              when 0 then "🥇"
              when 1 then "🥈"
              when 2 then "🥉"
              else "  "
              end
      puts "  #{medal} #{cyan(r[:id].ljust(28))} #{bold(green(r[:speed].to_s.rjust(6) + ' tok/s'))}  (#{r[:tokens_out]} tokens in #{r[:time]}s)"
    end
    puts bold("==========================================================================")
    if sorted.size >= 2
      fastest = sorted.first
      slowest = sorted.last
      ratio = (fastest[:speed] / [slowest[:speed], 0.01].max).round(2)
      puts green("⚡ Fastest model in Profile #{num} is #{bold(fastest[:id])} at #{fastest[:speed]} tok/s (#{ratio}x faster than #{slowest[:id]})")
    end
  end
end

