# Migrate existing monolithic profile configs into layered base.jsonc + compact deltas
def migrate_profiles(args = [])
  ensure_initialized

  dry_run = true
  if args.any? { |a| a =~ /^(--apply|-y|--yes|apply)$/i }
    dry_run = false
  end

  puts bold(dry_run ? "🔍 [DRY RUN] Analyzing profiles for base extraction..." : "🚀 Migrating profiles to layered base.jsonc architecture...")
  puts ""

  profiles = available_profile_nums
  if profiles.empty?
    warn red("No profiles found in #{SWITCH_DIR}")
    return
  end

  # 1. Load all profile configurations
  raw_configs = {}
  profiles.each do |p_num|
    p_dir = File.join(SWITCH_DIR, p_num)
    cfg_file = find_profile_config_file(p_dir)
    next unless cfg_file && File.exist?(cfg_file)
    raw_configs[p_num] = {
      path: cfg_file,
      content: (parse_jsonc(File.read(cfg_file)) rescue {})
    }
  end

  # 2. Extract candidate base invariants
  # Collect all plugins declared across all profiles
  all_plugins = raw_configs.values.flat_map { |v| v[:content]['plugin'] }.compact
  all_plugins = all_plugins.is_a?(Array) ? all_plugins.flatten.uniq : []
  # Ensure standard plugins like open-mem and tokenscope are present
  default_plugins = ['open-mem', '@ramtinj95/opencode-tokenscope']
  base_plugins = (default_plugins + all_plugins).uniq

  base_cfg = {
    '$schema' => 'https://opencode.ai/config.json',
    'lsp' => true,
    'formatter' => true,
    'instructions' => ['AGENTS.md'],
    'compaction' => {
      'auto' => true,
      'tail_turns' => 15
    },
    'plugin' => base_plugins
  }

  base_jsonc_text = <<~JSONC
    {
      "$schema": "https://opencode.ai/config.json",
      "lsp": true,
      "formatter": true,
      "instructions": [
        "AGENTS.md"
      ],
      "compaction": {
        "auto": true,
        "tail_turns": 15
      },
      // Universal plugins loaded across all profiles
      "plugin": #{JSON.pretty_generate(base_plugins).gsub("\n", "\n  ")}
    }
  JSONC

  # 3. Compute deltas for each profile
  deltas = {}
  stats = []

  raw_configs.each do |p_num, info|
    orig = info[:content]
    delta = orig.dup

    stripped_keys = []

    # Strip invariant top-level keys
    %w[$schema lsp formatter].each do |k|
      if delta.key?(k)
        delta.delete(k)
        stripped_keys << k
      end
    end

    # Strip instructions if standard ["AGENTS.md"]
    if delta['instructions'] == ['AGENTS.md']
      delta.delete('instructions')
      stripped_keys << 'instructions'
    end

    # Strip plugin if it is fully subsumed by base
    if delta['plugin'].is_a?(Array)
      if (delta['plugin'] - base_plugins).empty?
        delta.delete('plugin')
        stripped_keys << 'plugin'
      else
        delta['plugin'] = (delta['plugin'] - base_plugins)
        stripped_keys << 'plugin (custom kept)'
      end
    end

    # Strip compaction if identical to base, or strip identical subkeys
    if delta['compaction'].is_a?(Hash)
      if delta['compaction'] == { 'auto' => true, 'tail_turns' => 15 }
        delta.delete('compaction')
        stripped_keys << 'compaction'
      else
        # If it has custom fields like prune: true, reserved: 32000, remove auto: true if standard
        comp = delta['compaction'].dup
        comp.delete('auto') if comp['auto'] == true
        comp.delete('tail_turns') if comp['tail_turns'] == 15
        delta['compaction'] = comp unless comp.empty?
        delta.delete('compaction') if comp.empty?
        stripped_keys << 'compaction (custom delta kept)'
      end
    end

    orig_lines = JSON.pretty_generate(orig).lines.size
    new_lines = JSON.pretty_generate(delta).lines.size
    reduction_pct = (((orig_lines - new_lines).to_f / orig_lines) * 100).round(1)

    deltas[p_num] = delta
    stats << {
      num: p_num,
      orig_lines: orig_lines,
      new_lines: new_lines,
      reduction_pct: reduction_pct,
      stripped_keys: stripped_keys
    }
  end

  # Display Summary Table
  puts bold("=== Base Configuration to be created (~/.config/opencode-switcher/base.jsonc) ===")
  puts base_jsonc_text
  puts bold("=== Profile Delta Extraction Plan ===")
  puts sprintf("  %-8s %-12s %-12s %-12s %s", "Profile", "Original", "New Delta", "Reduction", "Keys Moved to Base")
  puts "  " + ("-" * 75)

  total_orig = 0
  total_new = 0
  stats.each do |s|
    total_orig += s[:orig_lines]
    total_new += s[:new_lines]
    puts sprintf("  %-8s %-12s %-12s %-12s %s",
      cyan(s[:num]),
      "#{s[:orig_lines]} lines",
      "#{s[:new_lines]} lines",
      green("-#{s[:reduction_pct]}%"),
      s[:stripped_keys].join(', ')
    )
  end

  total_reduction = (((total_orig - total_new).to_f / total_orig) * 100).round(1)
  puts "  " + ("-" * 75)
  puts sprintf("  %-8s %-12s %-12s %-12s",
    bold("TOTAL"),
    "#{total_orig} lines",
    "#{total_new} lines",
    bold(green("-#{total_reduction}% (#{total_orig - total_new} lines removed)"))
  )
  puts ""

  if dry_run
    puts yellow("ℹ DRY RUN COMPLETE: No files were modified.")
    puts "To apply this migration, run:"
    puts "  #{bold(green("oc conf migrate --apply"))}"
    return
  end

  # 4. Perform actual migration
  timestamp = Time.now.strftime('%Y%m%d_%H%M%S')
  backup_dir = File.join(SWITCH_DIR, ".backup_#{timestamp}")
  FileUtils.mkdir_p(backup_dir)

  puts cyan("Creating backup at #{backup_dir} ...")
  profiles.each do |p_num|
    src_dir = File.join(SWITCH_DIR, p_num)
    dest_dir = File.join(backup_dir, p_num)
    FileUtils.cp_r(src_dir, dest_dir)
  end
  puts green("✓ Backup created successfully.")

  # Write base.jsonc
  base_path = File.join(SWITCH_DIR, 'base.jsonc')
  File.write(base_path, base_jsonc_text)
  puts green("✓ Wrote #{base_path}")

  # Write profile deltas as config.jsonc
  deltas.each do |p_num, delta_data|
    p_dir = File.join(SWITCH_DIR, p_num)
    old_json = File.join(p_dir, 'config.json')
    new_jsonc = File.join(p_dir, 'config.jsonc')

    File.write(new_jsonc, JSON.pretty_generate(delta_data))
    FileUtils.rm_f(old_json) if File.exist?(old_json)
  end
  puts green("✓ Updated #{deltas.size} profiles with compact deltas (converted to config.jsonc).")

  # Recompile active profile
  active_num = get_default_profile
  if active_num
    compile_and_switch_profile(active_num)
    puts green("✓ Recompiled active profile #{bold(active_num)} to #{TARGET_CFG}")
  end

  puts ""
  puts bold(green("🎉 Migration successfully completed! All profiles now inherit from base.jsonc."))
end

# Install oc and opencode-switcher to a binary directory in PATH
def install_script(target_dir_arg = nil, extra_args = [])
  all_args = [target_dir_arg, *extra_args].compact

  if all_args.any? { |a| help_arg?(a) }
    puts bold("Install oc and opencode-switcher")
    puts ""
    puts bold("USAGE:")
    puts "  oc install [directory] [options]"
    puts "  oc conf install [directory] [options]"
    puts ""
    puts bold("OPTIONS:")
    puts "  [directory]        Target directory (default: ~/bin)"
    puts "  --dir <path>       Target directory"
    puts "  --prefix <path>    Target prefix (installs into <prefix>/bin)"
    puts "  -h, --help         Show this help message"
    return
  end

  # Parse directory from arguments
  chosen_dir = nil
  i = 0
  while i < all_args.size
    arg = all_args[i]
    if arg =~ /^--dir=(.+)$/
      chosen_dir = $1
    elsif arg == '--dir'
      i += 1
      chosen_dir = all_args[i]
    elsif arg =~ /^--prefix=(.+)$/
      chosen_dir = File.join($1, 'bin')
    elsif arg == '--prefix'
      i += 1
      chosen_dir = File.join(all_args[i], 'bin') if all_args[i]
    elsif !arg.start_with?('-') && chosen_dir.nil?
      chosen_dir = arg
    end
    i += 1
  end

  # Default target directory is ~/bin
  chosen_dir = chosen_dir && !chosen_dir.strip.empty? ? File.expand_path(chosen_dir) : File.expand_path('~/bin')


  source_file = (File.realpath(__FILE__) rescue nil) || File.expand_path(__FILE__)
  unless File.exist?(source_file)
    warn red("Error: Source script file not found at #{source_file}")
    exit 1
  end

  FileUtils.mkdir_p(chosen_dir)

  target_oc = File.join(chosen_dir, 'oc')
  target_switcher = File.join(chosen_dir, 'opencode-switcher')

  # Copy oc binary
  same_file = false
  if File.exist?(target_oc)
    begin
      same_file = File.identical?(source_file, target_oc) ||
                  (File.realpath(target_oc) == File.realpath(source_file))
    rescue StandardError
      same_file = (File.expand_path(target_oc) == File.expand_path(source_file))
    end
  end

  if same_file
    FileUtils.chmod(0755, target_oc)
    puts green("✓ #{bold(target_oc)} is up to date (permissions set to 0755)")
  else
    FileUtils.cp(source_file, target_oc)
    FileUtils.chmod(0755, target_oc)
    puts green("✓ Installed #{bold('oc')} to #{bold(target_oc)}")
  end

  # Create opencode-switcher symlink pointing to oc
  begin
    FileUtils.rm_f(target_switcher)
    Dir.chdir(chosen_dir) do
      FileUtils.ln_s('oc', 'opencode-switcher')
    end
    puts green("✓ Created symlink #{bold(target_switcher)} -> oc")
  rescue StandardError => e
    # Fallback to copy if symlinks are not supported
    FileUtils.cp(target_oc, target_switcher)
    FileUtils.chmod(0755, target_switcher)
    puts green("✓ Copied #{bold('opencode-switcher')} to #{bold(target_switcher)}")
  end

  # Check PATH
  path_dirs = (ENV['PATH'] || '').split(File::PATH_SEPARATOR).map { |d| File.expand_path(d) rescue d }
  if path_dirs.include?(File.expand_path(chosen_dir))
    puts green("✓ #{chosen_dir} is in your PATH")
    puts "\n#{bold('Success!')} You can now run #{cyan('oc')} or #{cyan('opencode-switcher')} from anywhere."
  else
    puts ""
    puts yellow("Notice:") + " #{bold(chosen_dir)} is not currently in your PATH."
    puts "To use 'oc' from anywhere, add the following line to your shell profile (~/.bashrc, ~/.zshrc, etc.):"
    puts "\n  #{cyan("export PATH=\"#{chosen_dir}:$PATH\"")}\n"
  end
end

# Sync oc and configuration to a remote machine over SSH
def sync_remote(remote_host, extra_args = [])
  all_args = [remote_host, *extra_args].compact

  if all_args.any? { |a| help_arg?(a) }
    puts bold("Sync oc and opencode-switcher to a remote machine")
    puts ""
    puts bold("USAGE:")
    puts "  oc ssh <remote> [-all]"
    puts "  oc conf ssh <remote> [-all]"
    puts ""
    puts bold("OPTIONS:")
    puts "  <remote>         SSH host (e.g. user@host)"
    puts "  -all, --all      Also sync ~/.config/opencode/AGENTS.md (with versioned remote backup)"
    puts "  -h, --help       Show this help message"
    return
  end

  # Parse -all / --all flag (may appear before or after <remote>)
  copy_all = all_args.any? { |a| a =~ /^-+all$/i }
  host = all_args.find { |a| a !~ /^-/ }

  if host.nil? || host.strip.empty?
    warn red("Error: Missing remote host. Usage: oc ssh <remote> [-all]")
    exit 1
  end

  puts bold("Syncing oc and opencode-switcher to #{cyan(host)}...")
  puts ""

  # Step A: Ensure remote directories exist
  puts cyan("  [1/4] Preparing remote directories...")
  prep_cmd = "mkdir -p ~/bin ~/.config/opencode-switcher"
  _out, _err, st = Open3.capture3('ssh', host, prep_cmd)
  unless st.success?
    warn red("Error: Failed to prepare remote directories on #{host}")
    warn _err.strip
    exit 1
  end
  puts green("  ✓ Remote directories ready")

  # Step B: Copy oc to remote ~/bin/ and set up symlink
  puts cyan("  [2/4] Copying oc to #{host}:~/bin/...")
  source_file = (File.realpath(__FILE__) rescue nil) || File.expand_path(__FILE__)
  unless File.exist?(source_file)
    warn red("Error: Source script file not found at #{source_file}")
    exit 1
  end

  _, _, st = Open3.capture3('scp', source_file, "#{host}:~/bin/oc")
  unless st.success?
    warn red("Error: Failed to copy oc to #{host}:~/bin/oc")
    exit 1
  end

  setup_cmd = "chmod +x ~/bin/oc; ln -sf oc ~/bin/opencode-switcher"
  _, _, st = Open3.capture3('ssh', host, setup_cmd)
  unless st.success?
    warn red("Error: Failed to set permissions/symlink on #{host}")
    exit 1
  end
  puts green("  Installed oc to #{host}:~/bin/oc (symlink opencode-switcher -> oc)")

  # Step C: Sync switcher config directory
  puts cyan("  [3/4] Syncing ~/.config/opencode-switcher/ ...")
  _, _, st = Open3.capture3('rsync', '-avz', '-e', 'ssh',
                            "#{SWITCH_DIR}/", "#{host}:~/.config/opencode-switcher/")
  unless st.success?
    warn red("Error: Failed to rsync switcher config to #{host}")
    exit 1
  end
  puts green("  Switcher config synced")

  # Step D: AGENTS.md handling
  agents_local = File.join(OPENCODE_DIR, 'AGENTS.md')
  if copy_all
    puts cyan("  [4/4] Syncing ~/.config/opencode/AGENTS.md ...")
    unless File.exist?(agents_local)
      warn yellow("  Warning: Local #{agents_local} not found; skipping AGENTS.md sync")
    else
      # Back up any existing remote AGENTS.md to a versioned .bak.NNN
      backup_cmd = <<~SH
        cd ~/.config/opencode 2>/dev/null || exit 0
        if [ -f AGENTS.md ]; then
          n=1
          while [ -f "AGENTS.md.bak.$(printf '%03d' $n)" ]; do n=$((n+1)); done
          cp AGENTS.md "AGENTS.md.bak.$(printf '%03d' $n)"
        fi
      SH
      _, _, st = Open3.capture3('ssh', host, backup_cmd)
      unless st.success?
        warn red("  Error: Failed to back up remote AGENTS.md on #{host}")
        exit 1
      end

      _, _, st = Open3.capture3('rsync', '-az', '-e', 'ssh',
                                agents_local, "#{host}:~/.config/opencode/AGENTS.md")
      unless st.success?
        warn red("  Error: Failed to rsync AGENTS.md to #{host}")
        exit 1
      end
      puts green("  AGENTS.md synced (remote backup created if needed)")
    end
  else
    puts cyan("  [4/4] Skipping ~/.config/opencode/AGENTS.md (not requested)")
    puts yellow("  Tip: Pass -all (e.g. oc ssh #{host} -all) to also sync ~/.config/opencode/AGENTS.md with automatic versioned remote backup.")
  end

  puts ""
  puts green("✓ Remote sync to #{bold(host)} complete.")
end

