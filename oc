# Configuration & Profile Subcommand Dispatcher
def dispatch_config_command(args)
  ensure_initialized

  if args.empty? || args.first == 'list' || args.first == '-l' || args.first == '--list' || args.first == 'ls'
    list_profiles
    return
  end

  if help_arg?(args.first)
    print_usage
    return
  end

  if version_arg?(args.first)
    puts "opencode-switcher v#{VERSION}"
    return
  end

  cmd = args.shift

  case cmd
  when 'migrate', 'consolidate', 'extract_base', 'extract-base'
    migrate_profiles(args)

  when 'test_models', 'test-models', 'bench_models', 'bench-models', 'models_speed', 'speed_models'
    num = args.shift
    test_models_in_profile(num, args.join(' ').empty? ? nil : args.join(' '))

  when 'benchmark', 'bench', 'speed'
    benchmark_profiles(args)

  when 'test', 'check', 'verify', 'diag'
    target = args.shift
    if target && target =~ /^(all|--all|-a)$/i
      test_all_profiles
    else
      test_profile(target, args.join(' ').empty? ? nil : args.join(' '))
    end

  when 'info', 'show', 'inspect', 'view'
    target_num = args.shift
    if target_num && target_num =~ /^(all|--all|-a)$/i
      available_profile_nums.each do |p|
        show_profile_info(p)
      end
    else
      show_profile_info(target_num)
    end

  when 'create', 'add', 'new'
    json_file = args.shift
    if json_file.nil?
      warn red("Error: Missing JSON file path. Usage: oc conf create <path/to/config.json>")
      exit 1
    end
    create_profile(json_file)

  when 'set_default', 'set-default', 'default', 'use', 'switch', 'set'
    num = args.shift
    if num.nil?
      warn red("Usage: oc conf set_default <profile_number>")
      exit 1
    end
    set_default_profile(num)

  when 'set_model', 'set-model', 'model'
    first = args.shift
    second = args.shift
    if second
      set_profile_model(first, second)
    elsif first
      set_profile_model(nil, first)
    else
      warn red("Usage: oc conf set_model [profile_number] <model_name>")
      exit 1
    end

  when 'set_desc', 'set-desc', 'set_description', 'description', 'desc'
    first = args.shift
    second = args.join(' ').strip
    if format_num(first) && !second.empty?
      set_profile_description(first, second)
    elsif first
      set_profile_description(nil, ([first] + args).join(' ').strip)
    else
      warn red("Usage: oc conf set_desc [profile_number] <description_text>")
      exit 1
    end

  when 'set_api', 'set-api', 'setkey'
    num = args.shift
    key = args.shift
    if num.nil? || key.nil?
      warn red("Usage: oc conf set_api <profile_number> <api_key_string>")
      exit 1
    end
    set_api_key(num, key)

  when 'install'
    target = args.shift
    install_script(target, args)

  when 'ssh', 'sync', 'remote'
    host = args.shift
    sync_remote(host, args)

  when 'version', '-v', '-V', '--version'
    puts "opencode-switcher v#{VERSION}"

  else
    # Check if pattern is: oc conf <number> set_desc <desc>
    if format_num(cmd) && args.first&.match?(/^(set_?desc|description|desc)$/i)
      args.shift
      desc = args.join(' ').strip
      if desc.empty?
        warn red("Usage: oc conf #{cmd} set_desc <description_text>")
        exit 1
      end
      set_profile_description(cmd, desc)
    # Check if pattern is: oc conf <number> test_models
    elsif format_num(cmd) && args.first&.match?(/^(test_?models|bench_?models|models_?speed)$/i)
      args.shift
      test_models_in_profile(cmd, args.join(' ').empty? ? nil : args.join(' '))
    # Check if pattern is: oc conf <number> bench
    elsif format_num(cmd) && args.first&.match?(/^(benchmark|bench|speed)$/i)
      args.shift
      benchmark_profiles([cmd] + args)
    # Check if pattern is: oc conf <number> test / check
    elsif format_num(cmd) && args.first&.match?(/^(test|check|verify|diag)$/i)
      args.shift
      test_profile(cmd, args.join(' ').empty? ? nil : args.join(' '))
    # Check if pattern is: oc conf <number> info / show
    elsif format_num(cmd) && args.first&.match?(/^(info|show|inspect)$/i)
      show_profile_info(cmd)
    # Check if pattern is: oc conf <number> set_model <model>
    elsif format_num(cmd) && args.first&.match?(/^(set_?model|model)$/i)
      args.shift
      model = args.shift
      if model.nil?
        warn red("Usage: oc conf #{cmd} set_model <model_name>")
        exit 1
      end
      set_profile_model(cmd, model)
    # Check if pattern is: oc conf <number> set_api <key>
    elsif format_num(cmd) && args.first&.match?(/^set_?api$/i)
      args.shift
      key = args.shift
      if key.nil?
        warn red("Usage: oc conf #{cmd} set_api <api_key_string>")
        exit 1
      end
      set_api_key(cmd, key)
    elsif format_num(cmd)
      set_default_profile(cmd)
    else
      warn red("Error: Unknown configuration command or profile '#{cmd}'")
      warn "Run 'oc help' or 'oc conf --help' for usage."
      exit 1
    end
  end
end

# OpenCode subcommands
OPENCODE_SUBCOMMANDS = %w[
  upgrade update uninstall acp api debug auth mcp plugin
  models stats mini run session service reload pair serve
  completion attach providers agent web export import github pr plug db
].freeze

MODEL_SUBCOMMANDS = %w[run mini].freeze

# ----------------------------------------------------
# Main Execution Dispatcher
# ----------------------------------------------------
ensure_initialized
sweep_stale_tmp_files

args = ARGV.dup
program_basename = File.basename($PROGRAM_NAME)

# If invoked as opencode-switcher, direct straight to config dispatcher
if program_basename =~ /^opencode-switcher/i
  dispatch_config_command(args)
  exit 0
end

# Check for top-level help triggers: oc help, oc -h, oc -H, oc -?, oc /?, oc /H, oc --help, etc.
if help_arg?(args.first)
  print_usage
  exit 0
end

# Check for top-level version triggers: oc version, oc -v, oc -V, oc --version
if version_arg?(args.first)
  puts "opencode-switcher v#{VERSION}"
  exit 0
end

# Check for profile management namespace: oc conf, oc config, oc cfg, oc switch
if args.first&.match?(/^(conf|config|cfg|switch)$/i)
  args.shift
  dispatch_config_command(args)
  exit 0
end

# Check for install command: oc install [dir]
if args.first&.match?(/^install$/i)
  args.shift
  target = args.shift
  install_script(target, args)
  exit 0
end

# Check for remote sync command: oc ssh <remote> [-all]
if args.first&.match?(/^(ssh|sync|remote)$/i)
  args.shift
  host = args.shift
  sync_remote(host, args)
  exit 0
end

# Check for explicit passthrough delimiter: oc -- <args...>
passthrough = false
if args.first == '--'
  args.shift
  target_profile_num = get_default_profile
  passthrough = true
else
  # Check if first argument is a profile number (e.g. oc 02 or oc 2)
  target_profile_num = nil
  if args.any?
    candidate = format_num(args.first)
    if candidate && Dir.exist?(File.join(SWITCH_DIR, candidate))
      target_profile_num = candidate
      args.shift
    end
  end
  target_profile_num ||= get_default_profile

  # Strip optional '--' after profile number (e.g. oc 02 -- -m custom).
  # Anything after '--' is forwarded verbatim to OpenCode.
  if args.first == '--'
    args.shift
    passthrough = true
  end
end

if target_profile_num.nil?
  warn red("Error: No OpenCode profiles configured in #{SWITCH_DIR}")
  warn "Run 'oc conf create <config.json>' to add a profile."
  exit 1
end

profile_dir = File.join(SWITCH_DIR, target_profile_num)
unless Dir.exist?(profile_dir)
  warn red("Error: Profile '#{target_profile_num}' directory not found at #{profile_dir}")
  exit 1
end

# 1. Source API_key.sh and inject variables into ENV
load_profile_env(target_profile_num)

# 2. Compile and activate effective configuration in ~/.config/opencode/opencode.json
profile_data = compile_profile_config(target_profile_num)
compile_and_switch_profile(target_profile_num)
profile_model = profile_data['model']

# 3. Model flag handling and argument transformation for OpenCode 2.0
# If invoked as 'oc run' without a message argument, treat as wanting to start OpenCode interactively
args.shift if !passthrough && args.first&.downcase == 'run' && !run_has_message?(args)

subcmd = args.first&.downcase
is_model_subcmd = subcmd && MODEL_SUBCOMMANDS.include?(subcmd)
is_known_subcmd = subcmd && OPENCODE_SUBCOMMANDS.include?(subcmd)


if passthrough
  # Explicit '--' delimiter: forward all remaining arguments to OpenCode unchanged
elsif is_model_subcmd
  has_model = args.any? { |a| a == '-m' || a == '--model' || a.start_with?('-m=') || a.start_with?('--model=') }
  args.insert(1, '-m', profile_model) if !has_model && profile_model
elsif is_known_subcmd
  # Subcommand does not accept -m; do not inject model flags
else
  # Root interactive TUI invocation: opencode [flags] [<directory>]
  # Extract any user-specified model override flag since root OpenCode 2.0 does not accept -m
  model_override = extract_model_override!(args)
  if model_override
    profile_model = model_override
    profile_data['model'] = model_override
    if profile_data['agent'].is_a?(Hash)
      profile_data['agent'].each_value do |agent_cfg|
        agent_cfg['model'] = model_override if agent_cfg.is_a?(Hash) && agent_cfg['model']
      end
    end
    atomic_write(TARGET_CFG, JSON.pretty_generate(profile_data))
    reload_opencode_service(restart: true)
  end

  # Check if arguments contain a positional prompt rather than a directory or flag
  if args.any? && !args.first.start_with?('-') && !File.directory?(args.first)
    has_prompt_flag = args.any? { |a| a == '--prompt' || a.start_with?('--prompt=') }
    unless has_prompt_flag
      prompt_parts = []
      prompt_parts << args.shift while args.any? && !args.first.start_with?('-') && !File.directory?(args.first)
      args.unshift('--prompt', prompt_parts.join(' ')) unless prompt_parts.empty?
    end
  end
end

# 4. Locate and execute opencode binary
opencode_bin = locate_opencode_bin
unless opencode_bin
  warn red("Error: Could not locate 'opencode' binary.")
  exit 1
end

$stderr.puts cyan("[oc] Active Profile: #{bold(target_profile_num)} | Model: #{bold(profile_model || '(default)')}")
exec(opencode_bin, *args)

